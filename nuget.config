<configuration>
  <packageSources>
      <clear />
      <!-- Remove the `nuget` entry if you want to consume _only_ private packages. -->
      <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceCredentials>
  </packageSourceCredentials>
</configuration>