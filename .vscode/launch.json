{
  "version": "0.2.0",
  "configurations": [
    {
      // .NET Framework (net481) wird mit dem "clr"-Debugger debuggt, nicht mit "coreclr". Nur unter Windows mit EPLAN
      // (gegen die Stubs gebaut startet EPLAN nicht). Lauscht auf \\.\pipe\pds-eplan wie der Dienst – ein laufender
      // Dienst pds-eplan muss dafür gestoppt sein.
      "name": "EPLAN-Worker: run (Named Pipe)",
      "type": "clr",
      "request": "launch",
      "preLaunchTask": "worker: build",
      "program": "${workspaceFolder}/worker/src/Pds.EplanWorker/bin/Debug/net481/pds-eplan.exe",
      "args": ["run", "--log-dir", "${workspaceFolder}/worker/logs"],
      "cwd": "${workspaceFolder}/worker/src/Pds.EplanWorker/bin/Debug/net481",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": true
    },
    {
      // Wie oben, aber EPLAN darf Dialoge zeigen (Lizenz, Anmeldung) – zur Fehlersuche beim EPLAN-Start
      "name": "EPLAN-Worker: run mit EPLAN-Dialogen",
      "type": "clr",
      "request": "launch",
      "preLaunchTask": "worker: build",
      "program": "${workspaceFolder}/worker/src/Pds.EplanWorker/bin/Debug/net481/pds-eplan.exe",
      "args": ["run", "--dialogs", "--log-dir", "${workspaceFolder}/worker/logs"],
      "cwd": "${workspaceFolder}/worker/src/Pds.EplanWorker/bin/Debug/net481",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": true
    },
    {
      // Eine Sitzung über stdin/stdout: Anfragen als JSON-Zeilen im Terminal eingeben, z. B.
      // {"type":"request","id":"1","method":"status","params":{}}
      // Logs gehen nach stderr und in worker/logs, nie nach stdout.
      "name": "EPLAN-Worker: stdio (JSON-Zeilen im Terminal)",
      "type": "clr",
      "request": "launch",
      "preLaunchTask": "worker: build",
      "program": "${workspaceFolder}/worker/src/Pds.EplanWorker/bin/Debug/net481/pds-eplan.exe",
      "args": ["stdio", "--log-dir", "${workspaceFolder}/worker/logs"],
      "cwd": "${workspaceFolder}/worker/src/Pds.EplanWorker/bin/Debug/net481",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": true
    }
  ]
}
