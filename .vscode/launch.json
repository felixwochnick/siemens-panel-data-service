{
  "version": "0.2.0",
  "configurations": [
    {
      // .NET Framework (net481) wird mit dem "clr" Debugger debuggt, nicht mit "coreclr"
      "name": "Einzelnes Projekt exportieren",
      "type": "clr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/EplanElectricP8Api/bin/Debug/net481/EplanElectricP8Api.exe",
      "args": ["export", "${input:projectPath}", "--output", "${input:outputFolder}"],
      "cwd": "${workspaceFolder}/src/EplanElectricP8Api/bin/Debug/net481",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": true
    },
    {
      // PROJECTS_PATH und OUTPUT_PATH aus der .env überschreiben project_folder/output_folder der config.yaml
      "name": "Alle Projekte exportieren (run --now, Pfade aus .env)",
      "type": "clr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/EplanElectricP8Api/bin/Debug/net481/EplanElectricP8Api.exe",
      "args": ["run", "--now"],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}/src/EplanElectricP8Api/bin/Debug/net481",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "projectPath",
      "type": "promptString",
      "description": "Pfad zur EPLAN Projektdatei (.elk)"
    },
    {
      "id": "outputFolder",
      "type": "promptString",
      "description": "Ausgabeordner für die Exporte",
      "default": "${workspaceFolder}/export"
    }
  ]
}
