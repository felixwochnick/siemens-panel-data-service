<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Alles, was ohne EPLAN auskommt: Protokoll, Sitzung, Prüfungen, raw.json schreiben.
    netstandard2.0, damit es der Worker (net481) und die Tests (net10.0, auch unter Linux) verwenden können.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Pds.EplanWorker</RootNamespace>
    <AssemblyName>Pds.EplanWorker.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="System.Text.Json" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pds.EplanWorker.Tests" />
  </ItemGroup>

</Project>
