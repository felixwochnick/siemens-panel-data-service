<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Konsolen-App (EPLAN Offline-Anwendung) -->
    <OutputType>Exe</OutputType>
    <!-- EPLAN Platform 2025 basiert auf .NET Framework 4.8.1 -->
    <TargetFramework>net481</TargetFramework>
    <!-- EPLAN ist 64-Bit, die App muss daher ebenfalls x64 sein -->
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>EplanElectricP8Api</RootNamespace>
    <AssemblyName>EplanElectricP8Api</AssemblyName>
    <!-- Referenzassemblies aus dem lokal installierten .NET Framework 4.8.1 Developer Pack verwenden (keine NuGet-Quelle nötig) -->
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Pfad zu den EPLAN API DLLs; kann per "dotnet build -p:EplanBinPath=..." überschrieben werden -->
    <EplanBinPath Condition="'$(EplanBinPath)' == ''">C:\Program Files\EPLAN\Platform\2025.0.3\Bin</EplanBinPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Der Starter wird ins Ausgabeverzeichnis kopiert: er findet zur Laufzeit die übrigen EPLAN DLLs -->
    <Reference Include="Eplan.EplApi.Starteru">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.Starteru.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Übrige EPLAN API Referenzen: nicht kopieren, sie werden zur Laufzeit über den AssemblyResolver aus dem EPLAN Bin-Ordner geladen -->
  <ItemGroup>
    <Reference Include="Eplan.EplApi.AFu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.AFu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.Baseu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.Baseu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.DataModelu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.DataModelu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.EServicesu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.EServicesu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.HEServicesu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.HEServicesu.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.MasterDatau">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.MasterDatau.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eplan.EplApi.Systemu">
      <HintPath>$(EplanBinPath)\Eplan.EplApi.Systemu.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.2" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.15.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Beispielkonfiguration neben die exe kopieren -->
    <None Update="config.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
