{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@pds/core/testing": [
        "./tests/core-testing.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}
