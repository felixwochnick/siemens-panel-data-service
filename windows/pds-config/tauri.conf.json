{
  "productName": "EPLAN Panel Data Service – Konfiguration",
  "identifier": "com.siemens-lpd.pds.config",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "EPLAN Panel Data Service – Konfiguration",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Siemens LPD",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
