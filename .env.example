# Lokale Entwicklung (pnpm dev) – Werte passen zu docker/docker-compose.dev.yml (pnpm db:up, pnpm sso:up)
NUXT_DATABASE_URL=mssql://pds_app:PdsDev-App-2026@localhost:1435/pds?trustServerCertificate=true
# Alternativ SQLite (eine Datei, kein SQL-Server-Container nötig):
# NUXT_DATABASE_URL=sqlite:./.data/pds.db
# Mindestens 32 Zeichen, z. B. `openssl rand -base64 32`
NUXT_APP_SECRET=local-dev-secret-change-me-0123456789abcdef
NUXT_PUBLIC_APP_URL=http://localhost:3400

# Test-OIDC (Dex). Für Microsoft Entra ID:
#   NUXT_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#   NUXT_OIDC_ROLES_CLAIM=roles, NUXT_OIDC_ADMIN_ROLES=<App-Rolle, z. B. Admin>
#   NUXT_PUBLIC_OIDC_PROVIDER_NAME=Microsoft
NUXT_OIDC_ISSUER=http://localhost:5558/dex
NUXT_OIDC_CLIENT_ID=pds
NUXT_OIDC_CLIENT_SECRET=pds-dev-secret
NUXT_OIDC_SCOPES=openid profile email groups
NUXT_OIDC_ROLES_CLAIM=groups
NUXT_OIDC_ADMIN_ROLES=admins
NUXT_PUBLIC_OIDC_PROVIDER_NAME=Dex (Test)

# KI-Assistenten (MCP-Server mit OAuth) – für die Entwicklung an, produktiv standardmäßig aus
NUXT_PUBLIC_MCP_ENABLED=true
